import empresaMensajeria.*
import paquete.*
import vehiculo.*
import mensajeros.*
import destinos.*

describe "Paquetes de george entregados por Neo" {
  test "El paquete de George que no está pago no puede ser llevado por Neo a la matrix." {

        paquete.pagar()

        assert.equals(false, paquete.puedeEntregar(neo, laMatrix))
  }


}

describe "Paquetes de George entregaods por JeanGray" {
    test "El paquete de George que si esta pago puede ser llevado por jean a la matrix" {

        paquete.pagar()

        assert.equals(true, paquete.puedeEntregar(jeanGray,laMatrix))
  }
}

describe "Paquetes de george entregados por Sara" {
  test "El paquete de George que sí está pago no puede ser llevado por Sara (que pesa 70kg) a Brooklyn si es que utiliza un camión con un acoplado y la entrega anterior puede hacerse si sara usa una moto" {
        paquete.pagar()
        sara.configurarPeso(70)
        sara.configurarVehiculo(camion)
        camion.cantAcoplados(1)
        assert.equals(false, paquete.puedeEntregar(sara,puenteBrooklyn))
        sara.configurarVehiculo(moto)
        assert.equals(true, paquete.puedeEntregar(sara,puenteBrooklyn) )
  }
}

describe "contratar a mensajero"{

  test" agrego a neo a la lista de empleados de la empresa"{

      empresaMensajeria.contratarMensajero(neo)
      assert.equals([neo], empresaMensajeria.listaDeMensajeros())

  }

}

describe "despedir a mensajero"{

  test" agrego a neo a la lista de empleados de la empresa"{

      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(sara)
      assert.equals([neo,sara], empresaMensajeria.listaDeMensajeros())
      empresaMensajeria.despedirMensajero(neo)
      assert.notEquals([neo,sara], empresaMensajeria.listaDeMensajeros())
      assert.equals([sara], empresaMensajeria.listaDeMensajeros())
  }
}
describe "Despedir a todos los mensajeros"{

  test  "saca todos los empleados de la lista de la empresa."{

      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(sara)
      empresaMensajeria.despedirATodos()
      assert.equals([], empresaMensajeria.listaDeMensajeros())
  }

}

describe "Analizar si la mensajeria es grande "{

  test " ver si la lista de mensajeros de la empresa tiene más de dos mensajeros, una mensajeria con 3 mensajeros es grande" {

      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(sara)
      empresaMensajeria.contratarMensajero(jeanGray)
      assert.equals (true , empresaMensajeria.esGrande()) //assert.that (empresaMensajeria.esGrande())
  }

  test "mensajeria con 2 mensajeros o con 1 mensajero no es grande"{
      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(sara)
      assert.notThat(empresaMensajeria.esGrande())

  }
}

describe "Consultar si el paquete puede ser entregado por el primer empleado de la la empresa de mensajería. " {

  test"el primero de la lista"{

      empresaMensajeria.contratarMensajero(jeanGray)
      empresaMensajeria.contratarMensajero(sara)
      empresaMensajeria.contratarMensajero(neo)
      assert.equals( jeanGray , empresaMensajeria.primeroDeLaEmpresa())
  }

  test " ver si el paquete puede entregarlo el primer empleado de la lista de mensajeros de la empresa." {

      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(sara)
      empresaMensajeria.contratarMensajero(jeanGray)
      paquete.pagar()
      neo.cargarCredito()
      assert.equals( true , paquete.puedeEntregar(empresaMensajeria.primeroDeLaEmpresa(), laMatrix))

  }

}

describe "Saber el peso del último mensajero de la empresa" {

  test "obtener el ultimo de la lista de la empresa"{
      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(jeanGray)
      empresaMensajeria.contratarMensajero(sara)
      assert.equals(sara, empresaMensajeria.ultimoDeLaEmpresa())
  }

  test "obtener el peso de sara que es el ultimo de la lista de la empresa." {

      empresaMensajeria.contratarMensajero(neo)
      empresaMensajeria.contratarMensajero(jeanGray)
      empresaMensajeria.contratarMensajero(sara)
      sara.configurarPeso(200)
      sara.configurarVehiculo(camion)
      camion.cantAcoplados(1)
      assert.equals(1200, empresaMensajeria.pesoDelUltimoMensajero())
    
  }
}
